# Brief API for the Kite shell (server-side proxy). Default = owned mvp/server.
# Leave unset to use http://127.0.0.1:3001/api (requires `npm run server` / `npm run dev`).
# Optional CC BY-NC Kagi smoke only: KITE_API_BASE=https://kite.kagi.com/api
# KITE_API_BASE=http://127.0.0.1:3001/api

# Legacy upstream env keys (unused by Informed News default path; kept for reference).
# VITE_BASE_PATH and VITE_STATIC_PATH previously pointed at kite.kagi.com for UI smoke.
VITE_BASE_PATH=
VITE_STATIC_PATH=
