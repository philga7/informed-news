{
  "name": "informed-news",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run server\" \"npm run web\"",
    "server": "npm run dev --prefix mvp/server",
    "web": "npm run dev --prefix mvp/web",
    "start": "npm run start --prefix mvp/server",
    "install:all": "npm install --prefix mvp/server && npm install --prefix mvp/web",
    "typecheck": "npm run typecheck --prefix mvp/server && npm run typecheck --prefix mvp/web",
    "test": "npm test --prefix mvp/server",
    "build": "npm run build --prefix mvp/web",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "semantic-release": "^24.2.3"
  }
}
