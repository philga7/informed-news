{
  "name": "informed-news",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.25.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,kite -c blue,magenta \"npm run server\" \"npm run kite\"",
    "server": "npm run dev --prefix mvp/server",
    "kite": "npm run dev --prefix apps/kite -- --port 5173 --strictPort",
    "start": "npm run start --prefix mvp/server",
    "install:all": "npm install --prefix mvp/server && npm run install:kite",
    "install:kite": "bun install --frozen-lockfile --cwd apps/kite",
    "typecheck": "npm run typecheck --prefix mvp/server",
    "test": "npm test --prefix mvp/server",
    "test:kite": "node --test tests/kite-upstream.test.js tests/dev-entrypoint.test.js tests/branding.test.js tests/kagi-service-cleanup.test.js tests/nav-shell.test.js tests/transparency.test.js tests/mvp-api-compat.test.js tests/retire-mvp-web.test.js",
    "test:e2e:kite": "playwright test e2e/kite-smoke.spec.ts",
    "build": "npm run build --prefix _legacy/mvp-web",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "semantic-release": "^24.2.3"
  }
}
