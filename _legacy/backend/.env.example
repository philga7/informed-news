# Supabase Configuration for Backend
# Copy this file to .env and fill in your actual values

# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Project URL (same as VITE_SUPABASE_URL in root .env)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (NOT the anon key - this has full database access)
# Found in Supabase Dashboard -> Settings -> API -> service_role key
# WARNING: Keep this secret! Do not commit to version control!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Port for backend server (defaults to 3001)
PORT=3001
