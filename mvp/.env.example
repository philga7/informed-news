PORT=3001
# Prefer bcrypt hash in production; plaintext is fine for local MVP.
# Generate: node -e "require('bcryptjs').hash('your-password',10).then(console.log)"
MVP_PASSWORD=change-me
# MVP_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.2
CFP_FEED_URL=https://citizenfreepress.com/feed/
FETCH_LIMIT=25
# Comma-separated X handles for xcancel ingest (optional). Empty = CFP-only.
# Example: XCANCEL_PROFILES=npr,bbcworld
XCANCEL_PROFILES=
# Optional: also load handles from mvp/data/x-profiles.json (gitignored).
# See mvp/data/x-profiles.example.json
XCANCEL_PER_PROFILE_LIMIT=10
XCANCEL_FETCH_DELAY_MS=1500
