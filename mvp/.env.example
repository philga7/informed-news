# Informed News server env. Copy to mvp/.env (local) or /opt/informed-news/.env (VPS).
# Placeholder values only. Never commit real secrets.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Set MVP_PASSWORD or MVP_PASSWORD_HASH (prefer the bcrypt hash in production),
# plus SESSION_SECRET.
# Generate: node -e "require('bcryptjs').hash('your-password',10).then(console.log)"
MVP_PASSWORD=change-me
# MVP_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
PORT=3001

# Ollama (Brief framing and summaries).
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.3-flash

# TypeSafe (Jev) — judgment-of-record for claim/evidence micro-judgments.
# Never log or commit this API key; keep it in the env file only.
TYPESAFE_API_KEY=
# Optional model override. Pinned by default; `jev-latest` drifts over time.
TYPESAFE_MODEL=jev-1.13.0

# Sources.
CFP_FEED_URL=https://citizenfreepress.com/feed/
# Curated radar RSS feeds: mvp/server/config/radar-sources.json (edit + restart; no env var).
FETCH_LIMIT=25
# Per-feed item cap for curated radar RSS. Unset/invalid = server default.
# RADAR_FETCH_LIMIT=25
# Optional: cap how many items to process per batch run (defaults to 10 each).
CLASSIFY_BATCH_LIMIT=10
ENRICH_BATCH_LIMIT=10
CLAIMS_EXTRACT_BATCH_LIMIT=10

# Paths.
# Data directory. Unset → mvp/data next to the server. The Compose volume mounts /app/mvp/data.
# MVP_DATA_DIR=
# Session cookie name. Unset or blank → mvp_session. A second instance on the same
# hostname sets its own name so the two logins do not replace each other.
# SESSION_COOKIE_NAME=mvp_session
# Compose data volume name. Unset on the live project → informed-news-data.
# A second project name gets its own volume. Do not point a QA project at informed-news-data.
# INFORMED_NEWS_DATA_VOLUME=informed-news-data
# Host port published on 127.0.0.1. Unset → 3001. The process inside the container still listens on 3001.
# INFORMED_NEWS_PORT=3001
# Env file the server loads at startup. Unset → mvp/.env next to the server.
# MVP_ENV_FILE=
# Directory holding the built Kite handler.js. Unset → Kite is not served by the API process.
# KITE_BUILD_DIR=
# Directory holding the built shell handler.js. Unset → the shell is not served by the API process.
# WEB_BUILD_DIR=

# Topic search. Unset → on. false / 0 / off / no disables both providers. See docs/TOPIC_SEARCH.md.
# TOPIC_SEARCH_ENABLED=true

# SearXNG base URL. Unset → Google News RSS only, one startup warning.
# Empty disables SearXNG with no startup warning.
# VPS, on Docker network nanobot-mem0: http://searxng:8080
# Optional laptop container: http://127.0.0.1:8888
# SEARXNG_URL=

# Triage (NEWS-87): keyword/mute → dedupe → Jev headline → scrape survivors → Jev body, on each refresh.
# Uses TYPESAFE_API_KEY / TYPESAFE_MODEL above. false / 0 / off / no (case-insensitive) disables it.
# See docs/TRIAGE.md.
TRIAGE_ENABLED=true
# Max Jev calls per refresh (non-negative integer; unset/invalid = 300). Over budget → not_scored_budget, retried next refresh.
TRIAGE_JEV_BUDGET=300
# Max Ollama Brief summaries per refresh (non-negative integer; unset/invalid = 60). Failed calls count.
# On-demand summaries (opening a story) are separate: capped at 30/hour. See docs/BRIEF.md.
TRIAGE_SUMMARY_BUDGET=60
# Reader feedback in scoring prompts (NEWS-190). Non-negative integers; unset/invalid = 20 entries / 1500 tokens (chars/4).
# TRIAGE_FEEDBACK_MAX_ENTRIES=20
# TRIAGE_FEEDBACK_TOKEN_BUDGET=1500

# Refresh (NEWS-88): hours between refreshes; decimals ok, minimum 0.25; unset/invalid = 3.
# Exactly 0 / off / false / no (case-insensitive) disables the timer and the startup catch-up;
# the Kite Refresh button and POST /api/fetch still work. See docs/BRIEF.md.
# REFRESH_INTERVAL_HOURS=3

# CourtListener API token for court-citation checks (NEWS-173). Server-only, never committed. Empty skips court checks.
COURTLISTENER_API_TOKEN=

# Postgres for stories, Morning items, and CFP roundups.
# COMPOSE_PROFILES=informed-news-postgres starts the live Postgres container. QA must not set informed-news-qa-postgres.
# The Postgres container reads mvp/postgres.env.example copied to postgres.env, not this file.
COMPOSE_PROFILES=informed-news-postgres
# Placeholder only. The real password stays in the env file, never in the repo.
# Live database name is in postgres.env (informed_news). QA sets INFORMED_NEWS_INSTANCE=qa and POSTGRES_DB=informed_news_qa in qa.env.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# INFORMED_NEWS_INSTANCE=
